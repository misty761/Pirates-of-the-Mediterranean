    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[13].name
      value: Scene 1N
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[14].name
      value: Scene 1O
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[15].name
      value: Scene 1P
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[0].chatString
      value: "Hey! Where do you think you\u2019re going?!"
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[0].nameString
      value: Merchant
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[1].chatString
      value: "I\u2019ve got a very urgent appointment!"
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[1].nameString
      value: Jack Staylow
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[2].chatString
      value: "Jack leaps over a crate of fruit. \nSeveral apples spill and roll across
        the ground."
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[2].nameString
      value: Narration
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[3].chatString
      value: My apples!!!
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[3].nameString
      value: Merchant
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[4].chatString
      value: Borrowing this!
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[4].nameString
      value: Jack Staylow
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[5].chatString
      value: He went this way!
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[5].nameString
      value: Soldier
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[6].chatString
      value: ...I may regret parts of yesterday.
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[6].nameString
      value: Jack Staylow
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[7].chatString
      value: 'Right.

        Let us review the situation.'
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[7].nameString
      value: Jack Staylow
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[8].chatString
      value: '(He looks around the cell.)

        Stone walls.

        Iron bars.

        No
        rum.'
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[8].nameString
      value: Jack Staylow
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[9].chatString
      value: This is clearly unacceptable.
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[9].nameString
      value: Jack Staylow
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[10].chatString
      value: 'Jack stands and stretches.

        He walks toward the bars.

        Outside,
        a royal guard snores loudly.

        Keys hang from the guard''s belt.'
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[10].nameString
      value: Narration
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[11].chatString
      value: 'Excellent.

        (He reaches through the bars.

        The keys
        are just slightly too far.)'
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[11].nameString
      value: Jack Staylow
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[12].chatString
      value: 'Further.

        Almost.

        (The guard snores louder and shifts
        position.

        Jack quickly pulls his arm back.)'
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[12].nameString
      value: Jack Staylow
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[13].chatString
      value: 'Right then.

        Perhaps a different approach.

        (Jack turns
        around and examines the back wall.

        One section of the stone wall
        has a long crack running through it.)'
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[13].nameString
      value: Jack Staylow
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[14].chatString
      value: "Good.\n(He looks between the sleeping guard\u2026 and the cracked wall.)\nSo
        how does one escape prison today?"
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[14].nameString
      value: Jack Staylow
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[15].chatString
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 6574975663053359403, guid: 6056f01e95dfba646bc4cc2b3ad70de0, type: 3}
      propertyPath: cutsceneData.Array.data[15].nameString
